# Vercel Postgres (Prisma integration). When you add the Vercel Postgres
# storage integration to the project, these are populated automatically;
# for local dev, copy them from the Vercel dashboard > Storage > .env.local tab.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Initial (and only) app user, used by `npm run seed`
APP_USER_EMAIL=""
APP_USER_PASSWORD=""
APP_USER_NAME=""
