# Prisma Postgres (Vercel storage integration). When you add the Prisma
# Postgres integration to the project, this is populated automatically
# (direct, non-Accelerate connection string); for local dev, copy it from
# the Vercel dashboard > Storage > your database > .env.local tab.
POSTGRES_URL=""

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Initial (and only) app user, used by `npm run seed`
APP_USER_EMAIL=""
APP_USER_PASSWORD=""
APP_USER_NAME=""
